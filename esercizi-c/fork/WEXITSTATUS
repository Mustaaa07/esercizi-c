#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
    int dim = 3; // Dimensione del vettore
    int v[dim]; // Vettore di numeri interi casuali
    int p2, p3, p4, p5, p6;

    // Processo P1: generazione del vettore V[]
    printf("P1: mio PID=%d, sto generando il vettore V[]\n", getpid());
    for (int i = 0; i < dim; i++) {
        v[i] = rand() % 6; // Genera numeri casuali compresi tra 0 e 5
    }

    // P1 genera il processo figlio P2
    p2 = fork();
    if (p2 == 0) {
        // Processo P2: annuncio e generazione di figli
        printf("P2: mio PID=%d, mio padre P1 ha PID=%d\n", getpid(), getppid());

        // P2 genera il processo figlio P4
        p4 = fork();
        if (p4 == 0) {
            // Processo P4: calcolo del prodotto delle componenti di V[]
            printf("P4: mio PID=%d, mio padre P2 ha PID=%d\n", getpid(), getppid());

            int prodotto = 1;
            for (int i = 0; i < dim; i++) {
                prodotto = prodotto * v[i];
            }
            printf("P4: il prodotto delle componenti di V[] è %d\n", prodotto);
            exit(0); // Termina il processo P4
        }
        wait(&p4); // P2 aspetta che P4 termini

        // P2 genera il processo figlio P5
        p5 = fork();
        if (p5 == 0) {
            // Processo P5: calcolo della media delle componenti di V[]
            printf("P5: mio PID=%d, mio padre P2 ha PID=%d\n", getpid(), getppid());

            int somma = 0;
            for (int i = 0; i < dim; i++) {
                somma = somma + v[i];
            }
            float media = (float)somma / dim;
            printf("P5: la media delle componenti di V[] è %.2f\n", media);
            exit(0); // Termina il processo P5
        }
        wait(&p5); // P2 aspetta che P5 termini
        exit(0); // Termina il processo P2
    }

    // P1 genera il processo figlio P3
    p3 = fork();
    if (p3 == 0) {
        // Processo P3: annuncio e gestione del vettore V[]
        printf("P3: mio PID=%d, mio padre P1 ha PID=%d\n", getpid(), getppid());

        printf("P3: il vettore V[] è [");
        for (int i = 0; i < dim; i++) {
            printf("%d ", v[i]);
        }
        printf("]\n");

        // P3 genera il processo figlio P6
        p6 = fork();
        if (p6 == 0) {
            // Processo P6: calcolo della somma delle componenti di V[]
            printf("P6: mio PID=%d, mio padre P3 ha PID=%d\n", getpid(), getppid());

            int somma = 0;
            for (int i = 0; i < dim; i++) {
                somma += v[i];
            }
            printf("P6: la somma delle componenti di V[] è %d\n", somma);
            exit(somma); // Restituisce la somma come valore di uscita
        }

        int status;
        wait(&status); // P3 aspetta che P6 termini
        int risultato = WEXITSTATUS(status); // Ottiene il risultato restituito da P6
        printf("P3: il risultato restituito da P6 = %d\n", risultato);
        exit(0); // Termina il processo P3
    }

    // P1 aspetta che P2 e P3 terminino
    wait(&p2);
    wait(&p3);

    // Fine del processo P1
    printf("P1: tutti i processi figli hanno terminato\n");
    return 0;
}
